    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.7"
  },
  "dependencies": {
    "@lucide/svelte": "^1.17.0",
    "dexie": "^4.4.7",
