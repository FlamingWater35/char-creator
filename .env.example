# Server-side configuration for the LLM proxy routes.
#
# Nothing here is required for local development: the custom provider is enabled
# automatically outside production, which is what `npm run dev` and
# `npm run preview` need for Ollama / LM Studio.

# Allow the "Custom / Local API" provider on a public deployment.
# Leaving this unset blocks arbitrary outbound URLs from the public endpoint,
# which is what prevents the proxy from being used as an open relay.
# CHAR_CREATOR_ALLOW_CUSTOM_PROVIDER=1

# Comma-separated hostnames the custom provider may contact. When set, it takes
# precedence over the blanket allow flag. Useful when hosting both the app and a
# local inference server on the same machine.
# CHAR_CREATOR_ALLOWED_HOSTS=localhost,127.0.0.1,ollama.internal
